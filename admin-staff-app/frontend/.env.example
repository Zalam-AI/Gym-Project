# Required: MongoDB connection string (MongoDB Atlas replica set recommended for production)
MONGODB_URI=your_mongodb_connection_string

# Required: Random secret (minimum 32 characters) for signing staff, mobile, & platform HMAC sessions
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GYMOS_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# Optional: Custom DNS servers if local network blocks MongoDB Atlas SRV lookups
MONGODB_DNS_SERVERS=

# Production CORS / CSRF Allowlists:
# Comma-separated origins for the Staff Website and standalone exported Mobile App
# (include Capacitor/WebView origins such as capacitor://localhost,https://localhost if packaging natively)
GYMOS_STAFF_APP_ORIGINS=https://app.yourdomain.com
GYMOS_MEMBER_APP_ORIGINS=https://m.yourdomain.com,capacitor://localhost,https://localhost

# Optional (Seed Script Only): Fixed ObjectId when running `npm run seed:admin`
GYMOS_GYM_ID=

# Optional (Seed Script Only): Bootstrap a Platform Administrator account when running `npm run seed:admin`
GYMOS_PLATFORM_ADMIN_EMAIL=
GYMOS_PLATFORM_ADMIN_PASSWORD=

# Sandbox / Embedded Iframe Preview ONLY — MUST remain 0 or unset in production!
GYMOS_ALLOW_PREVIEW_ORIGINS=0
