# Standalone Export / Native Mobile Build (Capacitor, Cordova, Static CDN):
# Public HTTPS origin of the GymOS API server (no trailing slash).
# Example: NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
# Leave empty ONLY when running behind a same-origin proxy or Next.js server rewrites.
NEXT_PUBLIC_API_BASE_URL=

# Optional (Next.js Server Mode Only): Internal origin used by Next.js `/api/*` rewrites
# when running `next dev` / `next start` without `NEXT_PUBLIC_API_BASE_URL`.
GYMOS_API_INTERNAL_URL=http://127.0.0.1:3000

# Set to 1 when building a standalone static mobile bundle (`npm run build:export` -> `out/`)
GYMOS_MOBILE_EXPORT=0

# Sandbox / Embedded Iframe Preview ONLY — MUST remain 0 or unset in production!
GYMOS_ALLOW_PREVIEW_ORIGINS=0
