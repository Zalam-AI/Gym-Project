# Production Mobile Build / Export (Render, Custom HTTPS Domain, Capacitor, Static CDN):
# Public HTTPS base URL of your deployed GymOS backend (no trailing slash).
# Example: NEXT_PUBLIC_API_BASE_URL=https://gymos-web-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=

# Optional (Next.js Server Proxy Mode / Local Dev Override):
# Internal origin used by Next.js `/api/*` rewrites when `NEXT_PUBLIC_API_BASE_URL` is unset.
# (`next dev` automatically loads `.env.development` for local development.)
GYMOS_API_INTERNAL_URL=

# Set to 1 when building a standalone static mobile bundle (`npm run export:member` -> `out/`)
GYMOS_MOBILE_EXPORT=0

# Sandbox / Embedded Iframe Preview ONLY — MUST remain 0 or unset in production!
GYMOS_ALLOW_PREVIEW_ORIGINS=0
